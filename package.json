{
  "name": "bhp-maintenance-hub",
  "version": "1.0.0",
  "description": "BHP Real Estate Holdings Maintenance Request Management System",
  "main": "server/index.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=18.x"
  }
}
